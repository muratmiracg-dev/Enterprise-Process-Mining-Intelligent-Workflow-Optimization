{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Events Loaded",
      "id": 1,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "process_optimizer_events_loaded", "legendFormat": "events"}]
    },
    {
      "type": "stat",
      "title": "Cases Loaded",
      "id": 2,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "process_optimizer_cases_loaded", "legendFormat": "cases"}]
    },
    {
      "type": "gauge",
      "title": "SLA Adherence",
      "id": 3,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.7},
              {"color": "green", "value": 0.85}
            ]
          }
        }
      },
      "targets": [{"expr": "process_optimizer_sla_adherence_ratio", "legendFormat": "SLA"}]
    },
    {
      "type": "timeseries",
      "title": "Analysis Duration (p95)",
      "id": 4,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(process_optimizer_analysis_duration_seconds_bucket[15m])))",
        "legendFormat": "p95"
      }]
    },
    {
      "type": "timeseries",
      "title": "Pipeline Runs",
      "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "sum by (status) (increase(process_optimizer_analysis_runs_total[1h]))",
        "legendFormat": "{{status}}"
      }]
    }
  ],
  "schemaVersion": 41,
  "tags": ["process-mining", "purchase-to-pay"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Enterprise Process Intelligence",
  "uid": "enterprise-process-intelligence",
  "version": 1
}
