table Variants
	column variant_rank
		dataType: int64
		summarizeBy: none
		sourceColumn: variant_rank
	column variant
		dataType: string
		summarizeBy: none
		sourceColumn: variant
	column case_count
		dataType: int64
		summarizeBy: sum
		sourceColumn: case_count
	column case_share
		dataType: double
		formatString: 0.0%
		summarizeBy: sum
		sourceColumn: case_share
	partition Variants = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("../reports/tables/variants.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Promoted
