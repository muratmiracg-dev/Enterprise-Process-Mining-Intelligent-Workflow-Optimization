// Enterprise Process Intelligence — governed DAX measure catalog
Cases = DISTINCTCOUNT(ProcessCases[case_id])
Total Spend = SUM(ProcessCases[amount_usd])
Average Spend per Case = DIVIDE([Total Spend], [Cases])
Median Cycle Hours = MEDIAN(ProcessCases[cycle_time_hours])
Average Cycle Hours = AVERAGE(ProcessCases[cycle_time_hours])
SLA Breached Cases = CALCULATE([Cases], ProcessCases[sla_breached] = TRUE())
SLA Adherence % = 1 - DIVIDE([SLA Breached Cases], [Cases])
Conformant Cases = CALCULATE([Cases], ProcessCases[conformant] = TRUE())
Straight Through % = DIVIDE([Conformant Cases], [Cases])
Conformance Fitness % = AVERAGE(ProcessCases[fitness])
Automation % = AVERAGE(ProcessCases[automation_rate])
Total Wait Hours = SUM(Bottlenecks[total_wait_hours])
Top Bottleneck Score = MAX(Bottlenecks[bottleneck_score])
Top Variant Cases = MAX(Variants[case_count])
Top Variant Share % = MAX(Variants[case_share])
Scored Cases = DISTINCTCOUNT(RiskPredictions[case_id])
High Risk Cases = CALCULATE([Scored Cases], RiskPredictions[risk_band] IN {"High", "Critical"})
High Risk Share % = DIVIDE([High Risk Cases], [Scored Cases])
Average Risk Score = AVERAGE(RiskPredictions[risk_score])
Scenario Cycle Hours = AVERAGE(SimulationScenarios[mean_cycle_hours])
Scenario SLA % = AVERAGE(SimulationScenarios[sla_adherence])
Scenario Annual Value = SUM(SimulationScenarios[estimated_annual_value_usd])
Scenario First-Year ROI = MAX(SimulationScenarios[first_year_roi])
Cycle Improvement vs Baseline % = 1 - DIVIDE([Scenario Cycle Hours], CALCULATE([Scenario Cycle Hours], SimulationScenarios[scenario] = "Baseline"))
SLA Uplift vs Baseline pp = 100 * ([Scenario SLA %] - CALCULATE([Scenario SLA %], SimulationScenarios[scenario] = "Baseline"))
